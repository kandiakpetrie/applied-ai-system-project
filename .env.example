# Copy this file to .env and paste in your own key:
#     cp .env.example .env
#
# Get a free Gemini API key at https://aistudio.google.com/apikey
#
# Only the LLM answer modes (naive and RAG) need this. Retrieval-only mode,
# the schedule, and the whole test suite work without it.
GEMINI_API_KEY=your_api_key_here
